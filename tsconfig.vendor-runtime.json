{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "noEmit": false,
    "rootDir": "packages",
    "outDir": "vendor-runtime/src",
    "declaration": false,
    "sourceMap": false
  },
  "include": [
    "packages/**/*.ts"
  ],
  "exclude": [
    "**/*.test.ts",
    "tests/**/*",
    "test/**/*"
  ]
}
