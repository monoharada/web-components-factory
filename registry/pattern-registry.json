{
  "schemaVersion": 1,
  "canonicalPrefix": "dads",
  "patterns": {
    "search-form": {
      "id": "search-form",
      "title": "検索フォーム（最小）",
      "description": "検索語の入力と送信ボタンだけの最小フォーム。",
      "requires": ["search-box", "button"],
      "html": "<form data-dads-typeset>\n  <dads-search-box label=\"検索\" name=\"q\"></dads-search-box>\n  <dads-button type=\"submit\" variant=\"solid\">検索</dads-button>\n</form>\n"
    },
    "table-with-pagination": {
      "id": "table-with-pagination",
      "title": "テーブル + ページネーション",
      "description": "一覧（テーブル）とページ移動コントロールの基本構成。",
      "requires": ["table", "page-navigation"],
      "html": "<div data-dads-typeset>\n  <dads-table>\n    <table>\n      <thead>\n        <tr>\n          <th scope=\"col\">項目</th>\n          <th scope=\"col\">値</th>\n        </tr>\n      </thead>\n      <tbody>\n        <tr>\n          <td>例</td>\n          <td>サンプル</td>\n        </tr>\n      </tbody>\n    </table>\n  </dads-table>\n\n  <dads-page-navigation current=\"1\" total=\"10\"></dads-page-navigation>\n</div>\n"
    },
    "card-grid": {
      "id": "card-grid",
      "title": "カードグリッド（見出し + 説明 + CTA）",
      "description": "カードの繰り返しで一覧を作るときのベース。",
      "requires": ["card", "heading", "typography", "button"],
      "html": "<section data-dads-typeset>\n  <dads-heading level=\"h2\">見出し</dads-heading>\n\n  <div style=\"display:grid; gap:16px; grid-template-columns:repeat(auto-fit, minmax(240px, 1fr));\">\n    <dads-card>\n      <dads-heading level=\"h3\" size=\"24\">カードタイトル</dads-heading>\n      <dads-text>説明文（短く）</dads-text>\n      <dads-button variant=\"outlined\">詳細</dads-button>\n    </dads-card>\n\n    <dads-card>\n      <dads-heading level=\"h3\" size=\"24\">カードタイトル</dads-heading>\n      <dads-text>説明文（短く）</dads-text>\n      <dads-button variant=\"outlined\">詳細</dads-button>\n    </dads-card>\n  </div>\n</section>\n"
    },
    "layout-website-hero-section-footer": {
      "id": "layout-website-hero-section-footer",
      "title": "レイアウト（Website: Hero + Section + Footer）",
      "description": "コンテンツ主導の1カラムサイト向けレイアウト。",
      "requires": ["layout-shell", "heading", "card", "button"],
      "html": "<dads-layout-shell data-dads-typeset pattern=\"website\" mode=\"auto\">\n  <header slot=\"header\">\n    <dads-heading level=\"1\">くらしの手続きポータル</dads-heading>\n    <p>必要な手続きを1つの画面で確認できます。</p>\n  </header>\n\n  <section>\n    <dads-card>\n      <dads-heading level=\"2\">はじめての方へ</dads-heading>\n      <p>制度の概要と申請までの流れを案内します。</p>\n      <dads-button variant=\"outlined\">詳しく見る</dads-button>\n    </dads-card>\n  </section>\n\n  <footer slot=\"footer\">© Digital Service</footer>\n</dads-layout-shell>\n"
    },
    "layout-app-shell": {
      "id": "layout-app-shell",
      "title": "レイアウト（App/SaaS: Header + Sidebar + Main）",
      "description": "業務アプリ向けの標準App Shellレイアウト。",
      "requires": ["layout-shell", "layout-sidebar", "heading", "card"],
      "html": "<dads-layout-shell data-dads-typeset pattern=\"app-shell\" mode=\"auto\">\n  <div slot=\"header\">\n    <dads-heading level=\"2\">業務ダッシュボード</dads-heading>\n  </div>\n\n  <dads-layout-sidebar slot=\"sidebar\">\n    <ul>\n      <li>案件一覧</li>\n      <li>承認待ち</li>\n      <li>設定</li>\n    </ul>\n  </dads-layout-sidebar>\n\n  <section>\n    <dads-card>\n      <dads-heading level=\"3\">進捗サマリー</dads-heading>\n      <p>主要KPIを表示します。</p>\n    </dads-card>\n  </section>\n</dads-layout-shell>\n"
    },
    "layout-master-detail": {
      "id": "layout-master-detail",
      "title": "レイアウト（Master-Detail: Main + Aside）",
      "description": "一覧 + 詳細を同時表示する2カラムレイアウト。",
      "requires": ["layout-shell", "layout-aside", "heading", "table"],
      "html": "<dads-layout-shell data-dads-typeset pattern=\"master-detail\" mode=\"auto\">\n  <section>\n    <dads-heading level=\"2\">申請一覧</dads-heading>\n    <dads-table>\n      <table>\n        <thead>\n          <tr><th scope=\"col\">申請ID</th><th scope=\"col\">状態</th></tr>\n        </thead>\n        <tbody>\n          <tr><td>A-1001</td><td>審査中</td></tr>\n          <tr><td>A-1002</td><td>差戻し</td></tr>\n        </tbody>\n      </table>\n    </dads-table>\n  </section>\n\n  <dads-layout-aside slot=\"aside\">\n    <dads-heading level=\"3\">詳細情報</dads-heading>\n    <p>選択中レコードの詳細を表示します。</p>\n  </dads-layout-aside>\n</dads-layout-shell>\n"
    }
  }
}
