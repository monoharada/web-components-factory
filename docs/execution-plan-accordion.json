{
  "project": {
    "name": "デジタル庁アコーディオンWeb Component開発",
    "duration": "2週間（10営業日）",
    "team_size": 2,
    "total_hours": 26,
    "budget": {
      "development": 26,
      "contingency": 3.9
    }
  },
  "overview": {
    "purpose": "デジタル庁デザインシステム準拠のアコーディオンコンポーネントをWeb Componentsで実装",
    "scope": {
      "included": [
        "dgov-accordion（親コンテナ）コンポーネント",
        "dgov-accordion-item（個別アイテム）コンポーネント",
        "デザイントークン統合",
        "アクセシビリティ完全対応",
        "レスポンシブデザイン実装",
        "パフォーマンス最適化",
        "自動テストスイート",
        "APIドキュメンテーション"
      ],
      "excluded": [
        "レガシーブラウザ（IE11）対応",
        "SSR/SSG対応",
        "既存実装との完全互換性"
      ]
    },
    "non_functional_requirements": {
      "performance": {
        "fcp": "< 1.8s",
        "fid": "< 100ms",
        "cls": "< 0.1",
        "fps": 60
      },
      "accessibility": "WCAG 2.2 AA",
      "i18n": {
        "rtl": true,
        "multi_language": true
      },
      "security": {
        "xss_prevention": true,
        "csp_compatible": true
      },
      "observability": {
        "telemetry": true,
        "custom_metrics": true
      }
    }
  },
  "phases": [
    {
      "id": "P1",
      "name": "Foundation",
      "duration_days": 1,
      "hours": 4.5,
      "purpose": "プロジェクト基盤とデザインシステム統合",
      "e2e_procedures": [
        "ls -la src/accordion/",
        "tsc --noEmit web-components.ts --strict",
        "node -e \"import './src/accordion/dgov-accordion.js'; console.log(customElements.get('dgov-accordion'))\"",
        "open tests/visual/tokens.html"
      ],
      "tasks": ["T-001", "T-002", "T-003"],
      "deliverables": [
        "src/accordion/ディレクトリ構造",
        "TypeScript設定ファイル",
        "WebComponentベースクラス",
        "デザイントークン定義ファイル"
      ],
      "acceptance_criteria": [
        "TypeScript strict modeでエラーなし",
        "WebComponentが正常に登録される",
        "デザイントークンが正しく適用される",
        "ビルドプロセスが正常動作"
      ]
    },
    {
      "id": "P2",
      "name": "Core Implementation",
      "duration_days": 2,
      "hours": 6,
      "purpose": "コアコンポーネント機能の実装",
      "e2e_procedures": [
        "open tests/integration/shadow-dom.html",
        "npm run test:integration -- --grep \"parent-child communication\"",
        "open tests/manual/state-management.html"
      ],
      "tasks": ["T-004", "T-005", "T-006"],
      "deliverables": [
        "Shadow DOM構造定義",
        "DgovAccordionItemクラス",
        "親子間通信メカニズム",
        "状態管理ロジック"
      ],
      "acceptance_criteria": [
        "Shadow DOMが正しくレンダリングされる",
        "Slotによるコンテンツ配置が機能する",
        "親子コンポーネント間の通信が確立される",
        "allow-multiple属性が正しく動作する"
      ]
    },
    {
      "id": "P3",
      "name": "Interaction & Accessibility",
      "duration_days": 2,
      "hours": 5,
      "purpose": "ユーザーインタラクションとアクセシビリティ実装",
      "e2e_procedures": [
        "npm run test:e2e -- --spec interaction.spec.ts",
        "open tests/manual/keyboard-nav.html",
        "npm run test:a11y",
        "# NVDA/JAWS/VoiceOverで動作確認"
      ],
      "tasks": ["T-007", "T-008", "T-009"],
      "deliverables": [
        "イベントハンドラー実装",
        "キーボードナビゲーション機能",
        "ARIA属性管理システム",
        "フォーカス管理ロジック"
      ],
      "acceptance_criteria": [
        "クリック/タッチで開閉動作",
        "Enter/Space/矢印キーが正しく機能",
        "aria-expanded/aria-controlsが動的更新",
        "スクリーンリーダーで正しく読み上げ"
      ]
    },
    {
      "id": "P4",
      "name": "Polish & Performance",
      "duration_days": 2,
      "hours": 4.5,
      "purpose": "アニメーションとパフォーマンス最適化",
      "e2e_procedures": [
        "npm run perf:animation",
        "npm run test:responsive",
        "npm run perf:metrics",
        "npm run lighthouse -- --only-categories=performance"
      ],
      "tasks": ["T-010", "T-011", "T-012"],
      "deliverables": [
        "スムーズなアニメーション実装",
        "レスポンシブスタイルシート",
        "パフォーマンス計測システム",
        "reduced-motion対応"
      ],
      "acceptance_criteria": [
        "アニメーションが60fpsで動作",
        "モバイル/タブレット/デスクトップ対応",
        "パフォーマンスメトリクス収集可能",
        "prefers-reduced-motion尊重"
      ]
    },
    {
      "id": "P5",
      "name": "Quality & Documentation",
      "duration_days": 3,
      "hours": 5.5,
      "purpose": "テスト自動化とドキュメント作成",
      "e2e_procedures": [
        "npm run test:all",
        "npm run coverage",
        "npm run docs:build",
        "npm run demo:serve && open http://localhost:8080"
      ],
      "tasks": ["T-013", "T-014", "T-015"],
      "deliverables": [
        "自動テストスイート",
        "E2Eテストシナリオ",
        "APIリファレンス",
        "使用例とデモサイト"
      ],
      "acceptance_criteria": [
        "WCAG 2.2 AA全項目合格",
        "E2Eテスト合格率100%",
        "APIドキュメント完成",
        "デモサイト公開"
      ]
    }
  ],
