/**
 * デジタル庁デザインシステム アコーディオンコンポーネント
 * details/summary要素ベースの実装
 * @version 2.0.0
 */

import { 
  WebComponent, 
  html, 
  css, 
  BooleanAttr, 
  PropertyAttr 
} from '../web-components';
import { 
  generateCSSVariables,
  createIconSVG,
  mediaQueries,
  spacing,
  borders
} from './design-tokens';

/**
 * dads-accordion-details コンポーネント
 * details/summary要素を活用したセマンティックな実装
 */
export class DadsAccordionDetails extends WebComponent {
  #allowMultiple = false;
  #animationType: 'none' | 'smooth' | 'bounce' = 'none';
  #respectMotionPreference = true;

  static definition = {
    name: 'dads-accordion-details',
    template: html`
      <div class="accordion-container" role="group">
        <slot></slot>
      </div>
    `,
    styles: css`
      :host {
        display: block;
        width: 100%;
        
        /* デザイントークンから生成されたCSS変数 */
        ${generateCSSVariables()}
        
        font-family: var(--font-family);
        color: var(--color-text);
      }
      
      .accordion-container {
        position: relative;
      }
      
      /* 高コントラストモード対応 */
      ${mediaQueries.prefersHighContrast} {
        :host {
          --focus-ring-width: 4px;
          --focus-ring-offset: 2px;
        }
      }
      
      /* モバイル対応 */
      ${mediaQueries.mobile} {
        :host {
          --font-size: var(--font-size-mobile);
          --line-height: var(--line-height-mobile);
        }
      }
      
      /* RTL対応 */
      :host([dir="rtl"]) {
        direction: rtl;
      }
    `,
    attributes: [
      BooleanAttr('allow-multiple'),
      PropertyAttr('animation'),
      BooleanAttr('respect-motion-preference')
    ]
  };

  connectedCallback() {
    super.connectedCallback();
    this.#initialize();
    this.#setupEventListeners();
    this.#applyMotionPreference();
  }

  #initialize() {
    // デフォルト設定
    if (!this.hasAttribute('animation')) {
      this.setAttribute('animation', 'none');
    }
    
    if (!this.hasAttribute('respect-motion-preference')) {
      this.setAttribute('respect-motion-preference', '');
    }
  }

  #setupEventListeners() {
    // details要素のトグルイベントを監視
    this.addEventListener('toggle', (e: Event) => {
      if (!this.#allowMultiple && (e.target as HTMLDetailsElement).open) {
        // 他のdetails要素を閉じる
        const allDetails = this.querySelectorAll('dads-accordion-item-details');
        allDetails.forEach(item => {
          const details = item.shadowRoot?.querySelector('details');
          if (details && details !== e.target && details.open) {
            details.open = false;
          }
        });
      }
    });
  }

  #applyMotionPreference() {
    if (this.#respectMotionPreference) {
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      if (prefersReducedMotion.matches) {
        this.setAttribute('animation', 'none');
      }
    }
  }

  attributeChangedCallback(name: string, oldValue: string | null, newValue: string | null) {
    super.attributeChangedCallback(name, oldValue, newValue);
    
    switch (name) {
      case 'allow-multiple':
        this.#allowMultiple = newValue !== null;
        break;
      case 'animation':
        this.#animationType = (newValue as 'none' | 'smooth' | 'bounce') || 'none';
        break;
      case 'respect-motion-preference':
        this.#respectMotionPreference = newValue !== null;
        this.#applyMotionPreference();
        break;
    }
  }
}

/**
 * dads-accordion-item-details コンポーネント
 * details/summary要素を使用した個別アイテム
 */
export class DadsAccordionItemDetails extends WebComponent {
  #details?: HTMLDetailsElement;
  #animating = false;

  static definition = {
    name: 'dads-accordion-item-details',
    template: html`
      <details>
        <summary class="accordion-summary">
          <span class="accordion-icon" aria-hidden="true">
            ${createIconSVG('arrowDown', 'icon-svg', 20)}
          </span>
          <span class="accordion-header">
            <slot name="header"></slot>
          </span>
        </summary>
        <div class="accordion-content">
          <div class="accordion-content-inner">
            <slot name="content"></slot>
            <button 
              class="accordion-return"
              type="button"
              aria-label="このセクションの先頭に戻る"
            >
              ${createIconSVG('returnArrow', 'return-icon', 24)}
              <span class="return-text">「<span class="header-text"></span>」の先頭に戻る</span>
            </button>
          </div>
        </div>
      </details>
    `,
    styles: css`
      :host {
        display: block;
        width: 100%;
        border-bottom: ${borders.width.thin} solid var(--color-border);
        
        ${generateCSSVariables()}
      }
      
      * {
        box-sizing: border-box;
      }
      
      /* details要素のリセット */
      details {
        width: 100%;
      }
      
      /* summaryのマーカーを非表示 */
      summary {
        list-style: none;
      }
      
      summary::-webkit-details-marker {
        display: none;
      }
      
      /* summaryのスタイリング */
      .accordion-summary {
        width: 100%;
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 8px 16px 8px 0;
        font-family: inherit;
        font-size: var(--font-size, 18px);
        line-height: var(--line-height, 1.6);
        color: var(--color-text, #333333);
        cursor: pointer;
        position: relative;
        transition: background-color 0.2s ease;
        user-select: none;
      }
      
      .accordion-summary:hover {
        background-color: var(--color-bg-hover, #f2f2f2);
      }
      
      /* フォーカススタイル */
      .accordion-summary:focus {
        outline: none;
        position: relative;
      }
      
      .accordion-summary:focus::before {
        content: '';
        position: absolute;
        inset: -4px;
        background-color: var(--color-focus, #ffd43d);
        border-radius: var(--border-radius-md, 8px);
        z-index: -1;
      }
      
      .accordion-summary:focus::after {
        content: '';
        position: absolute;
        inset: -8px;
        border: 4px solid var(--color-focus-ring, #000000);
        border-radius: calc(var(--border-radius-md, 8px) + 4px);
        pointer-events: none;
      }
      
      /* アイコン */
      .accordion-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        width: 32px;
        height: 32px;
        padding: 6px;
        background-color: var(--color-white, #ffffff);
        border: 1px solid var(--color-primary, #00118f);
        border-radius: var(--border-radius-full, 9999px);
        transition: border-width 0.15s ease;
      }
      
      .accordion-summary:hover .accordion-icon {
        border-width: 3px;
      }
      
      /* アイコンSVG */
      .icon-svg {
        width: 20px;
        height: 20px;
        color: var(--color-primary, #00118f);
        transition: transform 0.3s ease;
      }
      
      /* 展開時のアイコン回転 */
      details[open] .icon-svg {
        transform: rotate(180deg);
      }
      
      /* ヘッダー */
      .accordion-header {
        flex: 1;
        padding: 8px 0;
      }
      
      /* コンテンツエリア - アニメーション対応 */
      .accordion-content {
        overflow: hidden;
        will-change: height;
      }
      
      /* コンテンツの内部パディング */
      .accordion-content-inner {
        padding: 24px 0 24px 52px;
        font-size: 16px;
        line-height: 1.7;
        color: var(--color-text, #333333);
      }
      
      /* アニメーション設定 */
      details {
        transition: none;
      }
      
      /* スムーズアニメーション */
      :host-context([animation="smooth"]) details {
        & .accordion-content {
          animation: slideDown 300ms ease-out;
        }
        
        &:not([open]) .accordion-content {
          animation: slideUp 300ms ease-out;
        }
      }
      
      /* バウンスアニメーション */
      :host-context([animation="bounce"]) details {
        & .accordion-content {
          animation: slideDownBounce 400ms cubic-bezier(0.68, -0.55, 0.265, 1.55);
        }
        
        &:not([open]) .accordion-content {
          animation: slideUpBounce 400ms cubic-bezier(0.68, -0.55, 0.265, 1.55);
        }
      }
      
      /* アニメーションなし */
      :host-context([animation="none"]) details {
        & .accordion-content {
          animation: none;
        }
        & .icon-svg {
          transition: none;
        }
      }
      
      @keyframes slideDown {
        from {
          height: 0;
          opacity: 0;
        }
        to {
          height: var(--content-height, auto);
          opacity: 1;
        }
      }
      
      @keyframes slideUp {
        from {
          height: var(--content-height, auto);
          opacity: 1;
        }
        to {
          height: 0;
          opacity: 0;
        }
      }
      
      @keyframes slideDownBounce {
        0% {
          height: 0;
          opacity: 0;
          transform: translateY(-10px);
        }
        60% {
          height: var(--content-height, auto);
          transform: translateY(5px);
        }
        100% {
          opacity: 1;
          transform: translateY(0);
        }
      }
      
      @keyframes slideUpBounce {
        0% {
          height: var(--content-height, auto);
          opacity: 1;
          transform: translateY(0);
        }
        40% {
          transform: translateY(5px);
        }
        100% {
          height: 0;
          opacity: 0;
          transform: translateY(-10px);
        }
      }
      
      /* 先頭に戻るボタン */
      .accordion-return {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 16px;
        padding: 0;
        border: none;
        background: none;
        color: var(--color-primary, #00118f);
        font-size: 16px;
        line-height: 1.7;
        cursor: pointer;
        text-decoration: underline;
        text-underline-offset: 20%;
      }
      
      .accordion-return:hover {
        opacity: 0.8;
      }
      
      .return-icon {
        width: 24px;
        height: 24px;
        color: var(--color-primary, #00118f);
      }
      
      /* 閉じているときは非表示 */
      details:not([open]) .accordion-return {
        display: none;
      }
      
      /* 無効化状態 */
      :host([disabled]) .accordion-summary {
        cursor: not-allowed;
        opacity: 0.5;
        pointer-events: none;
      }
      
      /* アイコン位置（右） */
      :host([icon-position="right"]) .accordion-summary {
        flex-direction: row-reverse;
      }
      
      :host([icon-position="right"]) .accordion-content-inner {
        padding-left: 16px;
        padding-right: 52px;
      }
      
      /* モバイル対応 */
      @media (max-width: 768px) {
        .accordion-summary {
          padding: 4px 8px 8px 0;
          font-size: 16px;
          line-height: 1.7;
        }
        
        .accordion-icon {
          width: 24px;
          height: 24px;
          padding: 2px;
        }
        
        .icon-svg {
          width: 16px;
          height: 16px;
        }
        
        .accordion-content-inner {
          padding: 16px 8px 16px 32px;
        }
        
        :host([icon-position="right"]) .accordion-content-inner {
          padding-left: 8px;
          padding-right: 32px;
        }
      }
      
      /* 高コントラストモード */
      @media (prefers-contrast: high) {
        .accordion-summary {
          border: 2px solid ButtonText;
          color: ButtonText;
          background: ButtonFace;
        }
        
        .accordion-summary:hover {
          border-color: Highlight;
          color: HighlightText;
          background: Highlight;
        }
        
        .accordion-icon {
          border-width: 2px;
        }
      }
      
      /* RTL対応 */
      :host-context([dir="rtl"]) .accordion-summary {
        text-align: right;
        flex-direction: row-reverse;
      }
      
      :host-context([dir="rtl"]) .accordion-content-inner {
        padding-left: 16px;
        padding-right: 52px;
      }
      
      :host-context([dir="rtl"])[icon-position="right"] .accordion-summary {
        flex-direction: row;
      }
      
      :host-context([dir="rtl"])[icon-position="right"] .accordion-content-inner {
        padding-left: 52px;
        padding-right: 16px;
      }
    `,
    attributes: [
      BooleanAttr('expanded'),
      BooleanAttr('disabled'),
      PropertyAttr('icon-position')
    ]
  };

  connectedCallback() {
    super.connectedCallback();
    this.#initialize();
    this.#setupEventListeners();
    this.#updateHeaderText();
  }

  #initialize() {
    this.#details = this.shadowRoot?.querySelector('details') as HTMLDetailsElement;
    
    // 初期状態の設定
    if (this.hasAttribute('expanded')) {
      this.#details.open = true;
    }
    
    // アニメーション用の高さ計算
    this.#measureContentHeight();
  }

  #setupEventListeners() {
    const returnButton = this.shadowRoot?.querySelector('.accordion-return');
    
    returnButton?.addEventListener('click', (e) => {
      e.stopPropagation();
      this.#scrollToTop();
    });
    
    // details要素のトグルイベントをバブリング
    this.#details?.addEventListener('toggle', (e) => {
      // 親要素にイベントを伝播
      this.dispatchEvent(new Event('toggle', { bubbles: true }));
      
      // コンテンツの高さを再計算
      this.#measureContentHeight();
    });
  }

  #measureContentHeight() {
    const content = this.shadowRoot?.querySelector('.accordion-content-inner') as HTMLElement;
    if (content) {
      const height = content.offsetHeight;
      this.style.setProperty('--content-height', `${height}px`);
    }
  }

  #updateHeaderText() {
    const headerSlot = this.shadowRoot?.querySelector('slot[name="header"]') as HTMLSlotElement;
    const headerTextSpan = this.shadowRoot?.querySelector('.header-text') as HTMLSpanElement;
    
    if (headerSlot && headerTextSpan) {
      const updateText = () => {
        const assignedNodes = headerSlot.assignedNodes();
        const text = assignedNodes
          .map(node => node.textContent)
          .join('')
          .trim();
        headerTextSpan.textContent = text;
      };
      
      headerSlot.addEventListener('slotchange', updateText);
      updateText();
    }
  }

  #scrollToTop() {
    const summary = this.shadowRoot?.querySelector('.accordion-summary') as HTMLElement;
    summary?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    summary?.focus();
  }

  attributeChangedCallback(name: string, oldValue: string | null, newValue: string | null) {
    super.attributeChangedCallback(name, oldValue, newValue);
    
    if (!this.#details) return;
    
    switch (name) {
      case 'expanded':
        this.#details.open = newValue !== null;
        break;
      case 'disabled':
        if (newValue !== null) {
          this.#details.setAttribute('disabled', '');
        } else {
          this.#details.removeAttribute('disabled');
        }
        break;
    }
  }
  
  // Public API
  toggle() {
    if (this.#details) {
      this.#details.open = !this.#details.open;
    }
  }
  
  expand() {
    if (this.#details) {
      this.#details.open = true;
    }
  }
  
  collapse() {
    if (this.#details) {
      this.#details.open = false;
    }
  }
}

// コンポーネントの登録
DadsAccordionDetails.define();
DadsAccordionItemDetails.define();