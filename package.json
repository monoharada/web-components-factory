{
  "name": "web-components-factory",
  "version": "0.1.0",
  "description": "Web Components library with TDD approach",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "customElements": "custom-elements.json",
  "bin": {
    "dads-template": "./scripts/dads-template/cli.js",
    "wcf": "./scripts/wcf/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/monoharada/web-components-factory.git"
  },
  "scripts": {
    "dev": "bun --watch serve.ts",
    "dev:vite": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "pages:build": "node scripts/build-pages.cjs",
    "pages:preview": "node scripts/preview-pages.cjs",
    "pages:check:assets": "node scripts/check-pages-asset-requests.cjs",
    "assets:check:local": "node scripts/check-no-external-demo-assets.cjs",
    "cem:analyze": "cem analyze --config custom-elements-manifest.config.js",
    "cem:prefix": "node scripts/cem/transform-prefix.mjs",
    "validate:wc": "node scripts/wc/validate.mjs",
    "validate:demo-code-block": "node scripts/wc/validate-demo-code-block.mjs",
    "mcp:design-system": "node scripts/mcp/design-system-mcp.mjs",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:run": "vitest run",
    "test:run:json": "mkdir -p test-results && vitest run --reporter=json --outputFile=test-results/vitest.json",
    "test:e2e": "node scripts/run-playwright.cjs",
    "test:e2e:list-fidelity": "node scripts/run-playwright.cjs e2e-evidence/list.fidelity.vrt.spec.ts",
    "test:e2e:list-fidelity:update": "node scripts/run-playwright.cjs e2e-evidence/list.fidelity.vrt.spec.ts --update-snapshots",
    "test:e2e:resource-list-fidelity": "node scripts/run-playwright.cjs e2e-evidence/resource-list.fidelity.vrt.spec.ts",
    "test:e2e:resource-list-fidelity:update": "node scripts/run-playwright.cjs e2e-evidence/resource-list.fidelity.vrt.spec.ts --update-snapshots",
    "test:e2e:description-list-fidelity": "node scripts/run-playwright.cjs e2e-evidence/description-list.fidelity.vrt.spec.ts",
    "test:e2e:description-list-fidelity:update": "node scripts/run-playwright.cjs e2e-evidence/description-list.fidelity.vrt.spec.ts --update-snapshots",
    "test:e2e:menu-list-box": "node scripts/run-playwright.cjs e2e-evidence/menu-list-box.fidelity.spec.ts",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "tdd": "npm run test:watch",
    "ci": "npm run type-check && npm run test:run && npm run build",
    "skills:check": "node scripts/registry/check-skills-registry.mjs",
    "agents:pre-pr": "npm run skills:check && npm run cem:analyze && npm run contracts:check && npm run registry:generate && npm run registry:check && npm run validate:wc && node scripts/guards/check-generated-clean.mjs",
    "agents:verify": "npm run agents:pre-pr && npm run ci",
    "update-tokens": "node scripts/update-design-tokens.js",
    "check-tokens": "npm view @digital-go-jp/design-tokens version",
    "claude:plan": "mkdir -p docs/plans && echo 'Create implementation plan' && ls -la docs/plans/",
    "claude:review": "npm run lint && npm run type-check && npm run test:run && echo '✅ Review complete'",
    "claude:check": "npm run type-check && npm run lint && echo '✅ Code check complete'",
    "claude:clean": "rm -rf dist coverage .vitest && echo '🧹 Cleaned build artifacts'",
    "claude:docs": "mkdir -p docs/knowledge && echo '📚 Documentation structure:' && ls -la docs/",
    "claude:status": "git status && npm run type-check",
    "claude:verify": "npm run ci && echo '✅ All checks passed'",
    "claude:quick": "npm run type-check && npm run test:run",
    "claude:all": "npm run claude:check && npm run test:run && npm run build && echo '🎉 Full pipeline complete'",
    "codex:install-skills": "scripts/codex/install-skills.sh",
    "codex:perf:diagnose": "bash scripts/codex/perf-diagnose.sh",
    "codex:perf:rotate-log": "bash scripts/codex/rotate-tui-log.sh --threshold-mb 100",
    "dads:sync": "node scripts/dads/sync.cjs",
    "dads:validate": "node scripts/dads/validate.cjs",
    "dads:figma:add": "node scripts/dads/figma-add.cjs",
    "dads:figma:expand": "node scripts/dads/figma-expand.cjs",
    "validate:templates:quick": "node scripts/dads-template/cli.js validate templates --mode quick",
    "validate:templates": "node scripts/dads-template/cli.js validate templates --mode full",
    "templates:gaps:collect": "node scripts/dads-template/cli.js collect gaps --scope all --out tmp/template-gaps.json",
    "templates:gaps:dry-run": "npm run templates:gaps:collect && node scripts/dads-template/cli.js escalate gaps --input tmp/template-gaps.json",
    "templates:gaps:create": "npm run templates:gaps:collect && node scripts/dads-template/cli.js escalate gaps --input tmp/template-gaps.json --create",
    "vendor:build": "node scripts/vendor-runtime/build.js && npm run wcf:docs:build",
    "vendor:check": "node scripts/vendor-runtime/build.js --check",
    "wcf:docs:build": "node scripts/wcf/generate-docs.js",
    "wcf:docs:check": "node scripts/wcf/generate-docs.js --check",
    "wcf:smoke:node": "node scripts/wcf/smoke-ttfr.js --runner local",
    "wcf:smoke:bun": "node scripts/wcf/smoke-ttfr.js --runner bun-local",
    "wcf:smoke:npm": "node scripts/wcf/smoke-ttfr.js --runner npm",
    "wcf:smoke:bunx": "node scripts/wcf/smoke-ttfr.js --runner bunx",
    "wcf:channel:check": "node scripts/wcf/update-channel-lock.mjs --check",
    "wcf:channel:set-stable": "node scripts/wcf/update-channel-lock.mjs --ref main",
    "runtime:build": "vite build --config vite.runtime.config.ts",
    "size:esm": "node scripts/size/measure-esm.mjs --entry packages/components/date-picker/date-picker.ts --entry packages/components/calendar/calendar.ts",
    "contracts:check": "node scripts/contracts/check-autoload.mjs && node scripts/contracts/check-install-metadata.mjs",
    "registry:generate": "node scripts/registry/generate-install-registry.mjs",
    "registry:check": "node scripts/registry/generate-install-registry.mjs --check",
    "patterns:check": "node scripts/patterns/check-pattern-registry.mjs",
    "llms:generate": "node scripts/llms/generate-llms-docs.mjs",
    "llms:check": "node scripts/llms/generate-llms-docs.mjs --check"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@playwright/test": "^1.57.0",
    "@testing-library/dom": "^9.3.4",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/user-event": "^14.5.1",
    "@types/node": "^20.10.5",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "@wc-toolkit/cem-inheritance": "^1.2.2",
    "@wc-toolkit/cem-sorter": "^1.0.1",
    "@wc-toolkit/cem-validator": "^1.3.0",
    "@wc-toolkit/language-server": "^0.0.6",
    "@wc-toolkit/module-path-resolver": "^1.0.0",
    "@wc-toolkit/wctools": "^0.0.18",
    "eslint": "^8.57.0",
    "happy-dom": "^20.5.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "vite": "^6.4.1",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@digital-go-jp/design-tokens": "^1.1.1",
    "ajv": "^8.17.1",
    "yaml": "^2.8.1"
  },
  "keywords": [
    "web-components",
    "tdd",
    "typescript",
    "accessibility",
    "responsive"
  ],
  "author": "",
  "license": "MIT"
}
