{
  "name": "web-components-factory",
  "version": "0.1.0",
  "description": "Web Components library with TDD approach",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "customElements": "custom-elements.json",
  "bin": {
    "wcf": "bin/wcf.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/monoharada/web-components-factory.git"
  },
  "scripts": {
    "dev": "bun server.ts",
    "dev:vite": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "pages:build": "node scripts/build-pages.cjs",
    "pages:preview": "node scripts/preview-pages.cjs",
    "cem:analyze": "cem analyze --config custom-elements-manifest.config.js",
    "cem:prefix": "node scripts/cem/transform-prefix.mjs",
    "validate:wc": "node scripts/wc/validate.mjs",
    "validate:demo-code-block": "node scripts/wc/validate-demo-code-block.mjs",
    "mcp:design-system": "node scripts/mcp/design-system-mcp.mjs",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:run": "vitest run",
    "test:run:json": "mkdir -p test-results && vitest run --reporter=json --outputFile=test-results/vitest.json",
    "test:e2e": "node scripts/run-playwright.cjs",
    "test:e2e:list-fidelity": "node scripts/run-playwright.cjs e2e-evidence/list.fidelity.vrt.spec.ts",
    "test:e2e:list-fidelity:update": "node scripts/run-playwright.cjs e2e-evidence/list.fidelity.vrt.spec.ts --update-snapshots",
    "test:e2e:menu-list-box": "node scripts/run-playwright.cjs e2e-evidence/menu-list-box.fidelity.spec.ts",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "tdd": "npm run test:watch",
    "ci": "npm run type-check && npm run test:run && npm run build",
    "update-tokens": "node scripts/update-design-tokens.js",
    "check-tokens": "npm view @digital-go-jp/design-tokens version",
    "claude:plan": "mkdir -p docs/plans && echo 'Create implementation plan' && ls -la docs/plans/",
    "claude:review": "npm run lint && npm run type-check && npm run test:run && echo '✅ Review complete'",
    "claude:check": "npm run type-check && npm run lint && echo '✅ Code check complete'",
    "claude:clean": "rm -rf dist coverage .vitest && echo '🧹 Cleaned build artifacts'",
    "claude:docs": "mkdir -p docs/knowledge && echo '📚 Documentation structure:' && ls -la docs/",
    "claude:status": "git status && npm run type-check",
    "claude:verify": "npm run ci && echo '✅ All checks passed'",
    "claude:quick": "npm run type-check && npm run test:run",
    "claude:all": "npm run claude:check && npm run test:run && npm run build && echo '🎉 Full pipeline complete'",
    "codex:install-skills": "scripts/codex/install-skills.sh",
    "dads:sync": "node scripts/dads/sync.cjs",
    "dads:validate": "node scripts/dads/validate.cjs",
    "dads:figma:add": "node scripts/dads/figma-add.cjs",
    "dads:figma:expand": "node scripts/dads/figma-expand.cjs",
    "size:esm": "node scripts/size/measure-esm.mjs --entry packages/components/date-picker/date-picker.ts --entry packages/components/calendar/calendar.ts"
    ,
    "contracts:check": "node scripts/contracts/check-autoload.mjs && node scripts/contracts/check-install-metadata.mjs",
    "registry:generate": "node scripts/registry/generate-install-registry.mjs",
    "registry:check": "node scripts/registry/generate-install-registry.mjs --check",
    "patterns:check": "node scripts/patterns/check-pattern-registry.mjs"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@modelcontextprotocol/sdk": "^1.25.3",
    "@playwright/test": "^1.57.0",
    "@testing-library/dom": "^9.3.4",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/user-event": "^14.5.1",
    "@types/node": "^20.10.5",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitest/coverage-v8": "^1.6.0",
    "@vitest/ui": "^1.6.0",
    "@wc-toolkit/cem-inheritance": "^1.2.2",
    "@wc-toolkit/cem-sorter": "^1.0.1",
    "@wc-toolkit/cem-validator": "^1.3.0",
    "@wc-toolkit/language-server": "^0.0.6",
    "@wc-toolkit/module-path-resolver": "^1.0.0",
    "@wc-toolkit/wctools": "^0.0.18",
    "eslint": "^8.57.0",
    "happy-dom": "^14.12.3",
    "lit": "^3.1.1",
    "prettier": "^3.3.3",
    "vite": "^5.3.5",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "@digital-go-jp/design-tokens": "^1.1.1",
    "typescript": "^5.5.4"
  },
  "keywords": [
    "web-components",
    "tdd",
    "typescript",
    "accessibility",
    "responsive"
  ],
  "author": "",
  "license": "MIT"
}
